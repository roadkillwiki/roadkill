{
  // Settings for the integration tests. Each database is started in a throwaway container (Testcontainers), using
  // Docker or a Podman machine: nothing else needs to be installed or configured.
  "IntegrationTests": {
    // The databases to test: "SqlServer", "Postgres", "MongoDB". The integration tests of the other databases are ignored.
    "Databases": [ "SqlServer", "Postgres", "MongoDB" ],

    // The container engine API endpoint. Leave empty to auto-detect it (the Docker compatible socket or named pipe, which
    // Docker and the Podman machine provide by default), e.g. "npipe://./pipe/podman-machine-default" to force Podman on Windows.
    "ContainerEngineEndpoint": "",

    // The Testcontainers "resource reaper" (Ryuk) removes the containers if the test run is killed. Set to false if your
    // container engine can't run it (e.g. rootless Podman): the containers are still removed at the end of a normal run.
    "ResourceReaper": true
  }
}
