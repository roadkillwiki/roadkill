@model IEnumerable<TextToken>
@{
	Layout = "~/Views/Shared/_Blank.cshtml";
}
@* Markdown (Markdig, GitHub Flavored Markdown) and the Roadkill additions. The examples were checked with the Roadkill parser. *@

<table id="helptable">
	<thead>
		<tr>
		<th colspan="2">
			MARKDOWN SYNTAX REFERENCE
		</th>
		</tr>
	</thead>
	<tr>
		<td class="bold">Text</td>
		<td>
			**bold** &nbsp; *italic* &nbsp; ~~strikethrough~~ &nbsp; `code`<br />
			&lt;sup&gt;superscript&lt;/sup&gt; &nbsp; &lt;sub&gt;subscript&lt;/sub&gt;<br />
			Line break: end the line with two spaces. New paragraph: leave an empty line.
		</td>
	</tr>
	<tr>
		<td class="bold">Headings</td>
		<td>
			# Heading 1<br />
			## Heading 2<br />
			...<br />
			###### Heading 6<br />
			<i>The space after the # is optional (#Heading 1#).</i>
		</td>
	</tr>
	<tr>
		<td class="bold">Links</td>
		<td>
			<b>Spaces are not allowed in link URLs: use "-" instead of a space for a page title.</b><br /><br />

			Link to [a wiki page](My-page-title)<br />
			This is [the yahoo page](https://www.yahoo.com)<br />
			This is [the yahoo page][1]<br />
			[1]: https://www.yahoo.com<br /><br />

			Web addresses are links: https://www.yahoo.com or www.yahoo.com
		</td>
	</tr>
	<tr>
		<td class="bold">Images</td>
		<td>
			![Alt text](someimage.jpg)<br />
			![Alt text](someimage.jpg "Title")<br /><br />

			Size (width x height, in pixels, either can be left out):<br />
			![Alt text](someimage.jpg =250x100)<br />
			![Alt text](someimage.jpg =250x)
		</td>
	</tr>
	<tr>
		<td class="bold">Bulleted lists</td>
		<td>
			<b>A space is needed after the - (or *).</b>
<pre>- item 1
- item 2
  - item 2b</pre>
		</td>
	</tr>
	<tr>
		<td class="bold">Numbered lists</td>
		<td>
<pre>1. item 1
2. item 2
   1. item 2a</pre>
		</td>
	</tr>
	<tr>
		<td class="bold">Task lists</td>
		<td>
<pre>- [x] done
- [ ] to do</pre>
		</td>
	</tr>
	<tr>
		<td class="bold">Tables</td>
		<td>
			The second line separates the header, and its colons set the alignment:
<pre>| Left | Center | Right |
|:-----|:------:|------:|
| a    | b      | c     |</pre>
		</td>
	</tr>
	<tr>
		<td class="bold">Quotes and lines</td>
		<td>
			&gt; A quote<br /><br />
			A horizontal line: <code>---</code> on its own line (after an empty line)
		</td>
	</tr>
	<tr>
		<td class="bold">Code</td>
		<td>
			Inline: `code`<br /><br />
			A block, with its language (for the Syntax Highlighter plugin, see below):
<pre>```sql
select * from pages
```</pre>
			A block can also be indented by 4 spaces.
		</td>
	</tr>
	<tr>
		<td class="bold">Footnotes</td>
		<td>
<pre>Some text with a note[^1].

[^1]: The note, shown at the bottom of the page.</pre>
		</td>
	</tr>
	<tr>
		<td class="bold">Ignore wiki markup</td>
		<td>&lt;pre&gt;This will not render **bold**&lt;/pre&gt;</td>
	</tr>

	<tr>
		<th colspan="2">PLUGINS (they must be enabled in Site settings &gt; Plugins)</th>
	</tr>
	<tr>
		<td class="bold">Syntax highlighting<br /><i>(Syntax Highlighter)</i></td>
		<td>
			A code block with a language:
<pre>```csharp
int x = 1;
```</pre>
			or the Roadkill 2.x syntax: [[[code lang=sql|select * from pages]]]<br /><br />
			Languages: bash (shell), c, cpp, csharp (c#), css, delphi, diff, erlang, groovy, java, javafx, js (javascript),
			perl, php, plain (text), powershell, python (py), ruby, sass, scala, sql, vb, xml (html, xslt), actionscript3,
			applescript, coldfusion.
		</td>
	</tr>
	<tr>
		<td class="bold">Diagrams<br /><i>(Mermaid diagrams)</i></td>
		<td>
			Flowcharts, sequence diagrams, gantt charts... (<a href="https://mermaid.js.org/intro/" target="_blank">Mermaid syntax</a>):
<pre>```mermaid
graph TD
    A[Start] --&gt; B{Is it working?}
    B --&gt;|Yes| C[Great]
```</pre>
		</td>
	</tr>
	<tr>
		<td class="bold">Maths<br /><i>(Mathjax)</i></td>
		<td>
			TeX formulas (<a href="https://docs.mathjax.org/en/v3.2-latest/input/tex/index.html" target="_blank">MathJax TeX</a>):<br />
			On their own line: $$x = {-b \pm \sqrt{b^2-4ac} \over 2a}$$ or \\[x^2\\]<br />
			Inside the text: \\(a^2+b^2=c^2\\)<br />
			<b>The backslashes are doubled (\\( and \\[) because Markdown removes one.</b>
		</td>
	</tr>
	<tr>
		<td class="bold">Table of contents<br /><i>(Table of contents)</i></td>
		<td>{TOC} is replaced by a table of contents of the page headings.</td>
	</tr>
	<tr>
		<td class="bold">Jumbotron<br /><i>(Jumbotron)</i></td>
		<td>[[[jumbotron=your markdown here]]] adds a giant image (jumbotron.jpg in the attachments folder) at the top of the page, with the markdown over it.</td>
	</tr>

	@if (Model.Any())
	{
	<tr>
		<th colspan="2">CUSTOM TOKENS (App_Data/customvariables.xml)</th>
	</tr>
	}
	@foreach (TextToken token in Model)
	{
	<tr>
		<td class="bold" title="@token.SearchRegex">@Html.Raw(token.Name)</td>
		<td>@Html.Raw(token.Description)</td>
	</tr>
	 }
	<tfoot>
		<tr>
		<th colspan="2">
			<a href="https://github.github.com/gfm/" target="_blank">More information (GitHub Flavored Markdown)...</a>
		</th>
		</tr>
	</tfoot>
</table>
