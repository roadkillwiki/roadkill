@using Microsoft.AspNetCore.Diagnostics
@{
	IExceptionHandlerPathFeature errorFeature = Context.Features.Get<IExceptionHandlerPathFeature>();
}
@{
	if (ApplicationSettings.Installed)
	{
		Layout = SiteSettings.ThemePath + "/Theme.cshtml";
	}
}
<!DOCTYPE html>
<html>
<head>
	<title>Error</title>
</head>
<body>
	<h2>
		Sorry, an error occurred while processing your request.
	</h2>

@if (RoadkillContext.IsAdmin)
{
	if (errorFeature != null && errorFeature.Error != null)
	{
	<p>An error occurred on @errorFeature.Path</p>
	<p class="lead">@(errorFeature.Error.Message)</p>
	<pre class="alert alert-danger">@errorFeature.Error.ToString()</pre>
	}
}
</body>
</html>