@{
	string activeCss = "active";
	string nav1Active = activeCss;
	string nav2Active = "";
	string nav3Active = "";
	string nav4Active = "";
	string nav5Active = "";
	
	// Highlight the currently selected page using the CSS class and some viewdata
	if (ViewData["UsersActive"] !=  null)
	{
		nav1Active = "";
		nav2Active = activeCss;
		nav3Active = "";
		nav4Active = "";
		nav5Active = "";		
	}
	else if (ViewData["ToolsActive"] != null)
	{
		nav1Active = "";
		nav2Active = "";
		nav3Active = activeCss;
		nav4Active = "";
		nav5Active = "";		
	}
	else if (ViewData["CacheActive"] != null)
	{
		nav1Active = "";
		nav2Active = "";
		nav3Active = "";
		nav4Active = activeCss;
		nav5Active = "";
	}
	else if (ViewData["PluginSettingsActive"] != null)
	{
		nav1Active = "";
		nav2Active = "";
		nav3Active = "";
		nav4Active = "";
		nav5Active = activeCss;
	}
}

<div id="settings-navigation" class="navbar">
	<nav class="navbar navbar-default" id="admin-nav">
		<ul class="nav navbar-nav">
			<li class="@nav1Active">@Html.ActionLink(SiteStrings.SiteSettings_Configuration, "Index", "Settings", new { area = "SiteSettings" })</li>
			<li class="@nav2Active">@Html.ActionLink(SiteStrings.SiteSettings_UserManagement, "Index", "UserManagement")</li>
			<li class="@nav3Active">@Html.ActionLink(SiteStrings.SiteSettings_Tools, "Index", "Tools")</li>
			<li class="@nav4Active">@Html.ActionLink(SiteStrings.SiteSettings_Configuration_ObjectCaching, "Index", "Cache")</li>
			<li class="@nav5Active">@Html.ActionLink(SiteStrings.SiteSettings_Plugins_Title, "Index", "PluginSettings")</li>
		</ul>
	</nav>
</div>