@using Roadkill.Core.Configuration
@{
	// Uses the current theme's layout, once Roadkill is installed.
	// When changing this file, change the other _ViewStart.cshtml files (Views, Areas/SiteSettings/Views, Plugins) too.
	ApplicationSettings applicationSettings = Context.RequestServices.GetRequiredService<ApplicationSettings>();

	if (applicationSettings.Installed)
	{
		SiteSettings siteSettings = Context.RequestServices.GetRequiredService<Roadkill.Core.Services.SettingsService>().GetSiteSettings();
		Layout = siteSettings.ThemePath + "/Theme.cshtml";
	}
}
