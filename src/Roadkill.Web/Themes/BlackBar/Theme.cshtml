@inherits RoadkillLayoutPage
<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
	<title>@ViewBag.Title</title>
	@await Html.PartialAsync("HeadContent")
	@RenderSection("PluginHead", false)
</head>
<body>
	@using (Html.BeginForm("Search", "Home", new { area = "" }, FormMethod.Get))
	{
		<div id="header">
			<div id="loggedinas" class="left">
				@await Html.PartialAsync("~/Views/User/LoggedInAs.cshtml")
			</div>
			<div class="right">
					@Html.Raw(Context.RequestServices.GetRequiredService<Roadkill.Core.Services.IPageService>().GetMenu(RoadkillContext))
				<div id="searchbox" class="left">
					<input type="text" name="q" placeholder="@SiteStrings.Search_PlaceHolder" class="form-control" />
				</div>
			</div>
		</div>
	}

	<div id="page-content">
		@RenderSection("PageToolbar", false)
		@RenderSection("PluginPreContainer", false)

		<div id="container">
			@RenderSection("ViewHistoryLink", false)
			@RenderBody()

			<div id="footer">
				@RenderSection("PageDetailsFooter", false)
			</div>
		</div>

		@RenderSection("PluginPostContainer", false)
		@RenderSection("PluginFooter", false)
	</div>
</body>
</html>